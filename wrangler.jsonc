{
  "name": "wercpr",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*"]
  },
  "routes": [
    { "pattern": "wercpr.com", "custom_domain": true },
    { "pattern": "www.wercpr.com", "custom_domain": true }
  ]
}
